# ---- X Layer ----
XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech
XLAYER_MAINNET_RPC=https://rpc.xlayer.tech
# Deployer key for testnet deploys (never commit a real key)
PRIVATE_KEY=

# ---- AI layer ----
# Optional. Without a key the NL parser falls back to the deterministic grammar parser.
ANTHROPIC_API_KEY=
INTENTOS_AI_MODEL=claude-opus-5

# ---- Services ----
API_PORT=8787
INTENTOS_API_URL=http://localhost:8787
INTENTOS_RPC=http://127.0.0.1:8545
