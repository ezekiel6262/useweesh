# ---- X Layer ----
XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech
XLAYER_MAINNET_RPC=https://rpc.xlayer.tech
# Deployer key for testnet deploys (never commit a real key)
PRIVATE_KEY=

# Operator keys (written by deploy:testnet when derived from PRIVATE_KEY)
COORDINATOR_PRIVATE_KEY=
SOLVER_A_PRIVATE_KEY=
SOLVER_B_PRIVATE_KEY=

# ---- AI layer ----
# Grok / SpaceXAI is preferred. Claude is the fallback. Grammar runs if neither is set.
XAI_API_KEY=
ANTHROPIC_API_KEY=
INTENTOS_AI_MODEL=grok-4.5

# ---- Services ----
API_PORT=8787
INTENTOS_API_URL=http://localhost:8787
INTENTOS_RPC=https://testrpc.xlayer.tech
INTENTOS_NETWORK=xlayerTestnet
