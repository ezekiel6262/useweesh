{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:packages && npm run build -w @intentos/web",
  "outputDirectory": "apps/web/public",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60,
      "includeFiles": "deployments/**"
    }
  }
}
