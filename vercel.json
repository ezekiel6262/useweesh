{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:packages && npm run build:api && npm run build -w @intentos/web",
  "outputDirectory": "apps/web/public",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/*.ts": {
      "maxDuration": 60,
      "includeFiles": "bundled/**"
    }
  },
  "rewrites": [
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/intent", "destination": "/intent/index.html" },
    { "source": "/spec", "destination": "/spec/index.html" },
    { "source": "/standard", "destination": "/spec/index.html" },
    { "source": "/docs", "destination": "/docs/index.html" },
    { "source": "/how", "destination": "/how/index.html" },
    { "source": "/solvers", "destination": "/solvers/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/changelog", "destination": "/changelog/index.html" },
    { "source": "/history", "destination": "/history/index.html" },
    { "source": "/agents", "destination": "/agents/index.html" }
  ],
  "crons": [
    { "path": "/api/health", "schedule": "0 0 * * *" }
  ]
}
